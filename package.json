{
  "name": "dolmeng-homeshopping",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "돌멩홈쇼핑 세계 여행 특가전 - 초등 공개수업용 실시간 여행 상품 투표(구매) 사이트",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:sql": "node scripts/test-sql.mjs",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "playwright": "^1.63.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
