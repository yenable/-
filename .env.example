# ---------------------------------------------------------------------------
# 돌멩홈쇼핑 · 세계 여행 특가전 — 환경 변수 예시
# 이 파일을 복사해서 .env 파일을 만들고 값을 채워 주세요.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# .env 파일은 git에 올리지 마세요(.gitignore에 이미 포함되어 있습니다).
# ---------------------------------------------------------------------------

# Supabase 프로젝트 URL (Supabase 대시보드 > Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon(public) key — 브라우저에 노출되어도 되는 키입니다.
# ⚠️ service_role key는 절대 여기에 넣지 마세요. 브라우저 코드에 포함되면 안 됩니다.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# 수업 세션 슬러그 (DB class_sessions.slug 값과 같아야 합니다)
VITE_SESSION_SLUG=default

# ---------------------------------------------------------------------------
# Demo mode (Supabase 없이 전체 흐름을 체험하는 모드)
#   true  : 항상 demo mode로 실행 (브라우저 localStorage에만 저장)
#   false : 실제 Supabase 사용
# 값을 비워 두고 Supabase 변수도 없으면 자동으로 demo mode로 실행됩니다.
VITE_DEMO_MODE=false

# 운영 빌드에서 ?demo=1 쿼리로 demo mode가 켜지는 것을 허용할지 여부.
# 실제 공개수업용 빌드에서는 반드시 false(또는 미설정)로 두세요.
VITE_ALLOW_DEMO_QUERY=false

# ---------------------------------------------------------------------------
# ⚠️ 아래 값들은 "클라이언트 환경 변수로 넣지 않습니다".
#   - 학부모 공통 참여 코드  -> DB(class_sessions.parent_code_hash)에 해시로 저장
#   - 교사 계정 비밀번호      -> Supabase Auth 사용자로 관리
#   - service_role key        -> 서버/CLI에서만 사용
# ---------------------------------------------------------------------------
